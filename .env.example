# Groq API Configuration
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Model Selection
# Default: qwen/qwen3.8-27b
OPERON_MODEL_NAME=qwen/qwen3.8-27b
OPERON_TEMPERATURE=0.0

# Execution Settings
OPERON_MAX_RETRIES=3
OPERON_HUMAN_IN_THE_LOOP=true
# simulation: deterministic local workflows, no model API calls.
# auto: use Groq when a key is present, fall back locally if unavailable.
OPERON_ENVIRONMENT=simulation
